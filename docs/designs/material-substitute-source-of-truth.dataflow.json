    { "from": "receiving", "to": "inventory", "label": "posting tag", "classification": "actual stock", "variant": "emphasis", "labelAt": [635, 430] },
    { "from": "inventory", "to": "resolver", "label": "stok dan umur", "classification": "FIFO", "variant": "emphasis", "labelAt": [745, 430] },
    { "from": "resolver", "to": "trace", "label": "alokasi aktual", "classification": "part dan tag", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "violet", "title": "Master", "items": ["Satu substitute hanya untuk satu generic", "Part number unik", "Edit web tercatat"] },
    { "dot": "emerald", "title": "Eksekusi", "items": ["BOM meminta generic RM", "Receiving mencatat SKU aktual", "WO memilih stok substitute secara FIFO"] },
    { "dot": "amber", "title": "Direct supply", "items": ["Nomor generic dan SKU boleh sama", "FREE_ISSUE tidak menjadi substitute", "Part dan tag aktual tetap terlacak"] }
  ]
