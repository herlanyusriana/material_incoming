    { "id": "excel", "type": "external", "label": "Excel Referensi", "sublabel": "preview dan seed", "stage": 0, "row": 2, "width": 150, "tag": "tidak menimpa" },
    { "id": "material_master", "type": "database", "label": "Material Master", "sublabel": "part dan supply option", "stage": 1, "row": 1, "width": 160, "tag": "mapping eksklusif" },
    { "id": "planning", "type": "backend", "label": "BOM dan MRP", "sublabel": "kebutuhan generic RM", "stage": 2, "row": 0, "width": 150, "tag": "demand" },
    { "id": "receiving", "type": "frontend", "label": "Receiving Web", "sublabel": "SKU dan tag aktual", "stage": 2, "row": 2, "width": 150, "tag": "physical receipt" },
    { "id": "inventory", "type": "database", "label": "Inventory Material", "sublabel": "part, tag, lokasi, umur", "stage": 3, "row": 2, "width": 160, "tag": "qty on hand" },
    { "id": "resolver", "type": "backend", "label": "FIFO Resolver", "sublabel": "substitute aktif berstok", "stage": 3, "row": 0, "width": 160, "tag": "allocation rule" },
    { "id": "trace", "type": "database", "label": "WO dan WIP Trace", "sublabel": "part dan tag terpakai", "stage": 4, "row": 1, "width": 160, "tag": "genealogy" }
  ],
  "flows": [
    { "from": "web", "to": "material_master", "label": "kelola master", "classification": "validated", "variant": "emphasis" },
    { "from": "excel", "to": "material_master", "label": "seed awal", "classification": "preview", "variant": "dashed" },
    { "from": "material_master", "to": "planning", "label": "generic dan opsi", "classification": "master data", "variant": "emphasis" },
